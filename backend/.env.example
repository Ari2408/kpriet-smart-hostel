# ==============================================================================
# KPRIET Smart Hostel Attendance Management System - Environment Variables Template
# Copy this file to .env for local overrides, or set these on Render Cloud Dashboard.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application Environment ("development" or "production")
ENVIRONMENT=development

# Server Port (Render sets $PORT dynamically; fallback is 8000 for local dev)
PORT=8000

# Database Connection URL:
# For Local SQLite (development):
# DATABASE_URL=sqlite:///./smart_hostel.db
# For Supabase PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./smart_hostel.db

# JWT Cryptographic Signing Key (Generate a random 32+ character hex string in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# Supabase Cloud Storage Configuration (For persistent student biometric photographs)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Reconciled naming: The backend uses the service-role key to bypass Row-Level Security (RLS)
# for server-side photo uploads. Set SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_KEY) in Render.
# CRITICAL: NEVER embed service-role credentials in the Flutter client or public repositories.
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_BUCKET=student-profiles

# Startup Data Seeding Control
# Set to "false" in production to prevent automatically seeding synthetic demo accounts
SEED_DEMO_DATA=false
